# Docker Compose publishes only localhost. APP_PORT changes the host port;
# update APP_ORIGIN to match it. MySQL credentials live in .runtime/secrets/.
APP_PORT=8000
# These HOST/PORT values are for legacy direct startup; Compose overrides them.
HOST=127.0.0.1
PORT=8000
DATA_DIR=./data

# AKShare is a best-effort public-data adapter. Endpoint freshness/availability varies.
AKSHARE_ENABLED=true
QUOTE_REFRESH_SECONDS=300
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_CONCURRENCY=2
HISTORY_RETRY_SECONDS=3600
# Browser redraws the local index snapshot every second. Public upstream data is
# sampled by one server process at a bounded interval; it is not guaranteed real-time.
INDEX_POLL_SECONDS=15
INDEX_FEED_PROVIDER=akshare
# Futu OpenD runs locally and handles login in its official app. Enable this
# after installing OpenD; no Futu password or trading credential belongs here.
# 富途账号只在官方 OpenD 客户端登录；这里不填写账号或密码。
# 在 macOS 上，项目启动脚本会自动打开 OpenD；设置页按钮可再次打开官方登录窗口。
FUTU_ENABLED=false
# Compose overrides this with host.docker.internal to reach Mac-hosted OpenD.
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_POLL_SECONDS=3
# Futu trade is a separate OpenD context from quotes. Account discovery stays
# off until enabled. All real-order gates default off.
FUTU_TRADE_ENABLED=false
FUTU_TRADE_SECURITY_FIRM=FUTUSECURITIES
FUTU_SIMULATE_ORDERS_ENABLED=true
FUTU_REAL_ACCOUNT_IDS=
FUTU_REAL_SYMBOLS=
FUTU_REAL_ORDERS_ENABLED=false
FUTU_MAX_ORDER_NOTIONAL=1000
FUTU_MAX_DAILY_NOTIONAL=3000
# To enable Longbridge quote push, select longbridge above and configure its
# OpenAPI credentials below. These credentials may also authorize trading at
# Longbridge; keep .env private and do not enable live trading in this app.
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=

# AI research agent. Add provider keys only to your ignored local .env file.
AI_AGENT_RUNTIME=deerflow
# Optional private Skills/MCP directory. Default: DATA_DIR/agent-extensions.
AGENT_EXTENSIONS_DIR=
# Configure MODEL_CONFIG_JSON and PRIMARY_MODEL for an OpenAI-compatible model.
# Use api_key_env to keep the secret in its own environment variable.
# Add "supports_vision":true only if this endpoint/model accepts image_url content blocks.
# Official api.deepseek.com + deepseek-flash enables vision automatically.
# MODEL_CONFIG_JSON='[{"provider":"openai","model":"your-model-id","base_url":"https://your-openai-compatible-service/v1","api_key_env":"AI_MODEL_API_KEY","supports_vision":true}]'
MODEL_CONFIG_JSON=
PRIMARY_MODEL=
# Set MODEL_CONFIG_JSON using the commented template above.
AI_MODEL_API_KEY=
AI_MODEL_API_KEY_1=
AI_MODEL_API_KEY_2=
AI_MODEL_API_KEY_3=
AI_MODEL_API_KEY_4=
AI_MODEL_API_KEY_5=
AI_MODEL_API_KEY_6=
AI_MODEL_API_KEY_7=
MODEL_TEMPERATURE=0.2
MODEL_TIMEOUT_SECONDS=45
AGENT_RUN_TIMEOUT_SECONDS=120
AGENT_MAX_TOOL_CALLS=16
# Do not send a research question to other configured providers unless explicitly enabled.
AI_MODEL_FALLBACK_ENABLED=false

# Local paper starting balances are entered for each new account in the UI.
# Futu real orders also require all the Futu gates above and manual OpenD unlock.
LIVE_TRADING_ENABLED=false
BROKER_CONNECTIONS_JSON=[]
# Optional gateway process is disabled unless explicitly configured and started.
QMT_GATEWAY_ALLOW_ORDERS=false
QMT_GATEWAY_TOKEN=
QMT_ACCOUNT_ID=
QMT_USERDATA_PATH=
QMT_GATEWAY_DATA_DIR=

# Identity: single private owner, no public signup; password login by default.
# Run .venv/bin/python scripts/configure-local.py once to generate private keys.
# Then .venv/bin/python -m app.manage init-owner (interactive, password is never ENV).
APP_ORIGIN=http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=1200
AUTH_ENCRYPTION_KEY=
AUTH_AUDIT_KEY=
# Optional WeChat mini-program login. Keep the secret only on this server.
WECHAT_MINIPROGRAM_APPID=
WECHAT_MINIPROGRAM_SECRET=
# Non-loopback deployment requires HTTPS APP_ORIGIN and SESSION_COOKIE_SECURE=true.
# Keep AUTH_ENCRYPTION_KEY + AUTH_AUDIT_KEY in a private backup, outside Git.

# Data: public AKShare/Eastmoney web sources are not the licensed Choice SDK.
# Choice requires its own account/SDK/data permissions; it is not enabled here.
